# Copy to .env and fill in. Without a key the app runs on the rule-based parser.

# Groq key (https://console.groq.com/keys). LLM_API_KEY also works.
GROQ_API_KEY=

# Any OpenAI-compatible endpoint works; these are the defaults.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=10
LLM_REASONING_EFFORT=low
LLM_STRICT_SCHEMA=true

# Let the LLM rephrase result explanations (every sentence is grounding-checked).
EXPLAIN_WITH_LLM=true

APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
